<odoo>
  <record id="seq_ibco_shipment" model="ir.sequence">
    <field name="name">IBCO Shipment</field>
    <field name="code">ibco.shipment</field>
    <field name="prefix">SH/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_ibco_delivery" model="ir.sequence">
    <field name="name">IBCO Delivery</field>
    <field name="code">ibco.delivery</field>
    <field name="prefix">DEL/</field>
    <field name="padding">6</field>
  </record>
</odoo>
