<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Shipment list & form -->
  <record id="view_ibco_shipment_list" model="ir.ui.view">
    <field name="name">ibco.shipment.list</field>
    <field name="model">ibco.shipment</field>
    <field name="arch" type="xml">
      <list string="Shipments">
        <field name="name"/>
        <field name="vessel"/>
        <field name="arrival_date"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="state"/>
        <field name="total_expense"/>
        <field name="total_revenue"/>
        <field name="profit"/>
      </list>
    </field>
  </record>

  <record id="ibco_shipment_form_view" model="ir.ui.view">
    <field name="name">ibco.shipment.form</field>
    <field name="model">ibco.shipment</field>
    <field name="arch" type="xml">
      <form string="Shipment">
        <header>
          <button name="action_validate" type="object" string="Validate Shipment" 
                  invisible="state != 'draft'"
                  class="btn-primary"/>
          <button name="action_set_in_progress" type="object" string="Confirm Shipment" 
                  invisible="state != 'validated'"
                  class="btn-primary" />
          <button name="action_close" type="object" string="Close Shipment" 
                  invisible="state != 'in_progress'"
                  class="btn-primary"/>
          <button name="report_shipment" type="object" string="Print Profitability Report" 
                  class="btn-info" icon="fa-print" invisible="state not in ['in_progress', 'closed']"/>
          <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                  invisible="state == 'draft' "
                  confirm="This will reset the shipment to draft state and may affect related orders, invoices, and deliveries. Are you sure?"
                  class="btn-secondary"
                  groups="base.group_system"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,validated,in_progress,closed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-truck">
              <field name="delivery_count" widget="statinfo" string="Deliveries"/>
            </button>
            <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
              <field name="order_count" widget="statinfo" string="Orders"/>
            </button>
            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-money">
              <field name="invoice_count" widget="statinfo" string="Invoices"/>
            </button>
            <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-credit-card">
              <field name="expense_count" widget="statinfo" string="Expenses"/>
            </button>
            <button name="action_view_damage_expenses" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
              <field name="damage_expense_count" widget="statinfo" string="Damage Expenses"/>
            </button>
          </div>
          <group>
          <group>
            <field name="name" readonly="state != 'draft'"/>
            <field name="vessel" readonly="state in ['closed']"/>
            <field name="arrival_date" readonly="state in ['closed']"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            <field name="total_expense" readonly="1"/>
            <field name="total_revenue" readonly="1"/>
            <field name="profit" readonly="1"/>
          </group>
          </group>
            
          <notebook>
            <page string="Containers">
              <field name="container_ids" readonly="state != 'draft'">
                <form delete="0">
                  <group>
                    <field name="name"/>
                    <field name="container_volume"/>
                    <field name="seal_no"/>
                  </group>
                  <notebook>
                    <page string="Vehicles" name="vehicles_tab">
                      <field name="vehicles_only_ids" context="{'default_cargo_type': 'vehicle'}">
                        <list editable="bottom" string="Vehicles">
                          <field name="cargo_type" column_invisible="1"/>
                          <field name="name"/>
                          <field name="chassis_no"/>
                          <field name="make_model"/>
                          <field name="year"/>
                          <field name="color"/>
                          <field name="volume_m3"/>
                          <field name="quantity" readonly="1"/>
                          <field name="customer_id"/>
                          <field name="allocated_expense"/>
                          <field name="commission_amount"/>
                          <field name="damage_amount"/>
                          <field name="profit"/>
                          <field name="final_price"/>
                        </list>                       
                      </field>
                    </page>
                    <page string="Cargo" name="cargo_tab">
                      <field name="cargo_only_ids" context="{'default_cargo_type': 'cargo'}">
                        <list editable="bottom" string="Cargo">
                          <field name="cargo_type" column_invisible="1"/>
                          <field name="name"/>
                          <field name="cargo_description"/>
                          <field name="cargo_category"/>
                          <field name="cargo_weight"/>
                          <field name="is_hazardous"/>
                          <field name="volume_m3"/>
                          <field name="quantity"/>
                          <field name="customer_id"/>
                          <field name="allocated_expense"/>
                          <field name="commission_amount"/>
                          <field name="damage_amount"/>
                          <field name="profit"/>
                          <field name="final_price"/>
                        </list>
                      </field>
                    </page>
                  </notebook>
                </form>
              </field>
            </page>

            <page string="All Vehicles">
              <field name="all_vehicle_ids" context="{'default_cargo_type': 'vehicle'}" readonly="state != 'draft'">
                <list editable="bottom" string="All Vehicles" delete="0">
                  <field name="cargo_type" column_invisible="1"/>
                  <field name="container_id" domain="[('shipment_id', '=', parent.id)]" required="1"/>
                  <field name="name"/>
                  <field name="chassis_no"/>
                  <field name="make_model"/>
                  <field name="year"/>
                  <field name="color"/>
                  <field name="quantity" readonly="cargo_type == 'vehicle'"/>
                  <field name="volume_m3"/>
                  <field name="customer_id"/>
                  <field name="allocated_expense"/>
                  <field name="commission_amount"/>
                  <field name="damage_amount"/>
                  <field name="profit"/>
                  <field name="final_price"/>
                </list>
              </field>
            </page>

            <page string="All Cargo">
              <field name="all_cargo_ids" context="{'default_cargo_type': 'cargo'}" readonly="state != 'draft'">
                <list editable="bottom" string="All Cargo" delete="0">
                  <field name="cargo_type" column_invisible="1"/>
                  <field name="container_id" domain="[('shipment_id', '=', parent.id)]" required="1"/>
                  <field name="name"/>
                  <field name="cargo_description"/>
                  <field name="cargo_category"/>
                  <field name="cargo_weight"/>
                  <field name="is_hazardous"/>
                  <field name="quantity"/>
                  <field name="volume_m3"/>
                  <field name="customer_id"/>
                  <field name="allocated_expense"/>
                  <field name="commission_amount"/>
                  <field name="damage_amount"/>
                  <field name="profit"/>
                  <field name="final_price"/>
                </list>
              </field>
            </page>

            <page string="Damages">
              <field name="damage_ids">
                <list editable="bottom" delete="0">
                  <field name="vehicle_id"/>
                  <field name="partner_id"/>
                  <field name="amount"/>
                  <field name="name"/>
                  <field name="expense_id"/>
                  <button name="action_create_expense" type="object" string="Create Expense" 
                          invisible="expense_id != False"
                          class="btn-primary"/>
                </list>
              </field>
            </page>            
            <page string="Deliveries" invisible="state in ['draft', 'validated']">
              <field name="delivery_ids" readonly="state == 'closed'">
                <list create="0">
                  <field name="name"/>
                  <field name="customer_id"/>
                  <field name="state"/>
                  <field name="delivery_date"/>
                </list>
              </field>
            </page>

            <page string="HR Expenses">
              <field name="expense_ids" mode="list,form"/>
            </page>

            <page string="Attachments">
              <field name="attachment_ids" widget="many2many_binary"/>
            </page>
          </notebook>

        </sheet>
      </form>
    </field>
  </record>

  <!-- Actions -->
  <record id="action_ibco_shipments" model="ir.actions.act_window">
    <field name="name">Shipments</field>
    <field name="res_model">ibco.shipment</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
