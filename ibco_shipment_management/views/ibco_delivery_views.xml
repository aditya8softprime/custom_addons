<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_delivery_list" model="ir.ui.view">
    <field name="name">ibco.delivery.list</field>
    <field name="model">ibco.delivery</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="shipment_id"/>
        <field name="vehicle_id"/>
        <field name="customer_id"/>
        <field name="state"/>
        <field name="delivery_date"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_delivery_form" model="ir.ui.view">
    <field name="name">ibco.delivery.form</field>
    <field name="model">ibco.delivery</field>
    <field name="arch" type="xml">
      <form string="Delivery">
        <header>
          <button name="action_set_draft" type="object" string="Set to Draft" 
                  invisible="state == 'draft'" 
                  class="btn-secondary"/>
          <button name="action_set_in_transit" type="object" string="Set In Transit" 
                  invisible="state != 'draft'" 
                  class="btn-primary"/>
          <button name="action_mark_delivered" type="object" string="Mark Delivered" 
                  invisible="state != 'in_transit'" 
                  class="btn-primary"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,delivered"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="shipment_id"/>
              <field name="container_id"/>
              <field name="vehicle_id"/>
            </group>
            <group>
              <field name="customer_id"/>
              <field name="sale_order_id" readonly="state != 'draft'"/>
              <field name="invoice_id" readonly="state != 'draft'"/>
              <field name="delivery_date" required="state == 'delivered'" readonly="state == 'draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Release Documents" invisible="state == 'draft'">
              <field name="attachment_ids" widget="many2many_binary" required="state == 'delivered'"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Delivery Action -->
  <record id="action_ibco_deliveries" model="ir.actions.act_window">
    <field name="name">Deliveries</field>
    <field name="res_model">ibco.delivery</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>

