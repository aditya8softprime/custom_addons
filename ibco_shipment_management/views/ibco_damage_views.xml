<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_damage_list" model="ir.ui.view">
    <field name="name">ibco.damage.list</field>
    <field name="model">ibco.damage</field>
    <field name="arch" type="xml">
            <list>
        <field name="name"/>
        <field name="shipment_id"/>
        <field name="vehicle_id"/>
        <field name="partner_id"/>
        <field name="amount"/>
        <field name="date"/>
        <field name="expense_id"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_damage_form" model="ir.ui.view">
    <field name="name">ibco.damage.form</field>
    <field name="model">ibco.damage</field>
    <field name="arch" type="xml">
        <form string="Damage Record">
            <header>
                <button name="action_create_expense" type="object" string="Create Expense" 
                        invisible="expense_id != False"
                        class="btn-primary"/>
            </header>
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="shipment_id"/>
                        <field name="vehicle_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="expense_id" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
            </sheet>
        </form>
    </field>
  </record>

  <!-- Damage Action -->
  <record id="action_ibco_damages" model="ir.actions.act_window">
    <field name="name">Damages</field>
    <field name="res_model">ibco.damage</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

