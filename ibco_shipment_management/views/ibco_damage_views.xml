<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_damage_list" model="ir.ui.view">
    <field name="name">ibco.damage.list</field>
    <field name="model">ibco.damage</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="vehicle_id"/>
        <field name="shipment_id"/>
        <field name="amount"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_damage_form" model="ir.ui.view">
    <field name="name">ibco.damage.form</field>
    <field name="model">ibco.damage</field>
    <field name="arch" type="xml">
        <form string="Damage Record">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="shipment_id"/>
                    <field name="vehicle_id"/>
                    <field name="amount"/>
                    <!-- <field name="attachment_ids" widget="many2many_binary"/> -->
                </group>
            </sheet>
        </form>
    </field>
  </record>

  <!-- Damage Action -->
  <record id="action_ibco_damages" model="ir.actions.act_window">
    <field name="name">Damages</field>
    <field name="res_model">ibco.damage</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

