<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_vehicle_list" model="ir.ui.view">
    <field name="name">ibco.vehicle.list</field>
    <field name="model">ibco.vehicle.line</field>
    <field name="arch" type="xml">
      <list>
        <field name="chassis_no"/>
        <field name="make_model"/>
        <field name="customer_id"/>
        <field name="container_id"/>
        <field name="volume_m3"/>
        <field name="allocated_expense"/>
        <field name="commission_amount"/>
        <field name="final_price"/>
        <field name="delivery_id"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_vehicle_form" model="ir.ui.view">
    <field name="name">ibco.vehicle.form</field>
    <field name="model">ibco.vehicle.line</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="chassis_no"/>
            <field name="make_model"/>
            <field name="year"/>
            <field name="color"/>
            <field name="customer_id"/>
            <field name="container_id"/>
            <field name="volume_m3"/>
          </group>
          <group>
            <field name="allocated_expense" readonly="1"/>
            <field name="commission_amount" readonly="1"/>
            <field name="final_price" readonly="1"/>
            <field name="delivery_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ibco_vehicles" model="ir.actions.act_window">
    <field name="name">Vehicles</field>
    <field name="res_model">ibco.vehicle.line</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>

