<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_expense_list" model="ir.ui.view">
    <field name="name">ibco.expense.list</field>
    <field name="model">ibco.expense</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="expense_type"/>
        <field name="amount"/>
        <field name="shipment_id"/>
        <field name="container_id"/>
      </list>
    </field>
  </record>

  <!-- Expense Action -->
  <record id="action_ibco_expenses" model="ir.actions.act_window">
    <field name="name">Expenses</field>
    <field name="res_model">ibco.expense</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

