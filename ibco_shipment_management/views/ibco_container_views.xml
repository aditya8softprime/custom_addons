<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_container_list" model="ir.ui.view">
    <field name="name">ibco.container.list</field>
    <field name="model">ibco.container</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="container_volume"/>
        <field name="shipment_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="total_volume"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_container_form" model="ir.ui.view">
    <field name="name">ibco.container.form</field>
    <field name="model">ibco.container</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="container_volume"/>
            <field name="seal_no"/>
            <field name="company_id" groups="base.group_multi_company"/>
            <field name="shipment_id"/>
            <field name="total_volume" readonly="1"/>
          </group>
          <notebook>
            <page string="Vehicles" name="vehicles_tab">
              <field name="vehicles_only_ids" context="{'default_cargo_type': 'vehicle'}">
                <list string="Vehicles" editable="bottom">
                  <field name="cargo_type" column_invisible="1"/>
                  <field name="name"/>
                  <field name="chassis_no"/>
                  <field name="make_model"/>
                  <field name="year"/>
                  <field name="color"/>
                  <field name="volume_m3"/>
                  <field name="customer_id"/>
                  <field name="allocated_expense" readonly="1"/>
                  <field name="commission_amount"/>
                  <field name="damage_amount" readonly="1"/>
                  <field name="profit" readonly="1"/>
                  <field name="final_price" readonly="1"/>
                  <field name="delivery_id"/>
                </list>
                <form>
                  <group>
                    <group>
                      <field name="cargo_type" invisible="1"/>
                      <field name="name"/>
                      <field name="chassis_no"/>
                      <field name="make_model"/>
                      <field name="year"/>
                      <field name="color"/>
                      <field name="volume_m3"/>
                      <field name="customer_id"/>
                    </group>
                    <group>
                      <field name="allocated_expense" readonly="1"/>
                      <field name="commission_amount"/>
                      <field name="damage_amount" readonly="1"/>
                      <field name="profit" readonly="1"/>
                      <field name="final_price" readonly="1"/>
                      <field name="delivery_id"/>
                    </group>
                  </group>
                </form>
              </field>
            </page>
            <page string="Cargo" name="cargo_tab">
              <field name="cargo_only_ids" context="{'default_cargo_type': 'cargo'}">
                <list string="Cargo" editable="bottom">
                  <field name="cargo_type" column_invisible="1"/>
                  <field name="name"/>
                  <field name="cargo_category"/>
                  <field name="cargo_weight"/>
                  <field name="is_hazardous"/>
                  <field name="volume_m3"/>
                  <field name="customer_id"/>
                  <field name="allocated_expense" readonly="1"/>
                  <field name="commission_amount"/>
                  <field name="damage_amount" readonly="1"/>
                  <field name="profit" readonly="1"/>
                  <field name="final_price" readonly="1"/>
                  <field name="delivery_id"/>
                </list>
                <form>
                  <group>
                    <group>
                      <field name="cargo_type" invisible="1"/>
                      <field name="name"/>
                      <field name="cargo_category"/>
                      <field name="cargo_weight"/>
                      <field name="is_hazardous"/>
                      <field name="volume_m3"/>
                      <field name="customer_id"/>
                    </group>
                    <group>
                      <field name="allocated_expense" readonly="1"/>
                      <field name="commission_amount"/>
                      <field name="damage_amount" readonly="1"/>
                      <field name="profit" readonly="1"/>
                      <field name="final_price" readonly="1"/>
                      <field name="delivery_id"/>
                    </group>
                  </group>
                  <group>
                    <field name="cargo_description" placeholder="Enter detailed cargo description..."/>
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ibco_containers" model="ir.actions.act_window">
    <field name="name">Containers</field>
    <field name="res_model">ibco.container</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
  
</odoo>
