<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Arrival Shipment Views -->
    <record id="view_ibco_arrival_shipment_tree" model="ir.ui.view">
        <field name="name">ibco.arrival.shipment.tree</field>
        <field name="model">ibco.arrival.shipment</field>
        <field name="arch" type="xml">
            <list string="Arrival Shipments">
                <field name="name"/>
                <field name="vessel_name"/>
                <field name="arrival_date"/>
                <field name="total_containers"/>
                <field name="total_cargo_lines"/>
                <field name="total_quantity"/>
                <field name="state" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'completed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ibco_arrival_shipment_form" model="ir.ui.view">
        <field name="name">ibco.arrival.shipment.form</field>
        <field name="model">ibco.arrival.shipment</field>
        <field name="arch" type="xml">
            <form string="Arrival Shipment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Arrival" 
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Complete" 
                            invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                            invisible="state == 'draft'" class="btn-secondary"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="vessel_name" readonly="state == 'completed'"/>
                            <field name="arrival_date" readonly="state == 'completed'"/>
                            <field name="shipment_id" readonly="state == 'completed'" 
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="total_containers" readonly="1"/>
                            <field name="total_cargo_lines" readonly="1"/>
                            <field name="total_quantity" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Containers">
                            <field name="arrival_container_ids" readonly="state == 'completed'">
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="marks"/>
                                        <field name="seal_no"/>
                                    </group>
                                    <notebook>
                                        <page string="Cargo Lines">
                                            <field name="cargo_line_ids">
                                                <list editable="bottom" string="Cargo Lines">
                                                    <field name="description"/>
                                                    <field name="quantity"/>
                                                </list>
                                                <form>
                                                    <group>
                                                        <field name="description"/>
                                                        <field name="quantity"/>
                                                    </group>
                                                </form>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        
                        <page string="Notes">
                            <field name="notes" placeholder="Enter any general notes about this arrival..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Arrival Container Views -->
    <record id="view_ibco_arrival_container_tree" model="ir.ui.view">
        <field name="name">ibco.arrival.container.tree</field>
        <field name="model">ibco.arrival.container</field>
        <field name="arch" type="xml">
            <list string="Arrival Containers">
                <field name="name"/>
                <field name="arrival_shipment_id"/>
                <field name="marks"/>
                <field name="total_cargo_lines"/>
                <field name="total_quantity"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Arrival Cargo Line Views -->
    <record id="view_ibco_arrival_cargo_line_tree" model="ir.ui.view">
        <field name="name">ibco.arrival.cargo.line.tree</field>
        <field name="model">ibco.arrival.cargo.line</field>
        <field name="arch" type="xml">
            <list string="Arrival Cargo Lines">
                <field name="arrival_shipment_id"/>
                <field name="arrival_container_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ibco_arrival_cargo_line_form" model="ir.ui.view">
        <field name="name">ibco.arrival.cargo.line.form</field>
        <field name="model">ibco.arrival.cargo.line</field>
        <field name="arch" type="xml">
            <form string="Arrival Cargo Line">
                <sheet>
                    <group>
                        <field name="arrival_shipment_id"/>
                        <field name="arrival_container_id" domain="[('arrival_shipment_id', '=', arrival_shipment_id)]"/>
                        <field name="description"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_ibco_arrival_shipments" model="ir.actions.act_window">
        <field name="name">Arrival Shipments</field>
        <field name="res_model">ibco.arrival.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_arrival_date': context_today()}</field>
    </record>



</odoo>