<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit HR Expense Form View -->
    <record id="hr_expense_form_view_shipment" model="ir.ui.view">
        <field name="name">hr.expense.form.shipment</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="shipment_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="container_id" options="{'no_create': True, 'no_open': True}" invisible="is_damage_expense"/>
                <field name="vehicle_id" options="{'no_create': True, 'no_open': True}" readonly="1" invisible="not is_damage_expense"/>
            </field>
        </field>
    </record>

    <!-- Inherit HR Expense Tree View -->
    <record id="hr_expense_tree_view_shipment" model="ir.ui.view">
        <field name="name">hr.expense.tree.shipment</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.view_expenses_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="shipment_id" optional="hide"/>
                <field name="container_id" optional="hide"/>
                <field name="vehicle_id"/>
            </field>
        </field>
    </record>
</odoo>
