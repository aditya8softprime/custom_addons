<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ibco_delivery_line_list" model="ir.ui.view">
    <field name="name">ibco.delivery.line.list</field>
    <field name="model">ibco.delivery.line</field>
    <field name="arch" type="xml">
      <list>
        <field name="delivery_id"/>
        <field name="container_id"/>
        <field name="vehicle_id"/>
        <field name="sequence"/>
      </list>
    </field>
  </record>

  <record id="view_ibco_delivery_line_form" model="ir.ui.view">
    <field name="name">ibco.delivery.line.form</field>
    <field name="model">ibco.delivery.line</field>
    <field name="arch" type="xml">
      <form string="Delivery Line">
        <sheet>
          <group>
            <field name="delivery_id"/>
            <field name="container_id"/>
            <field name="vehicle_id"/>
            <field name="sequence"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Delivery Line Action -->
  <record id="action_ibco_delivery_lines" model="ir.actions.act_window">
    <field name="name">Delivery Lines</field>
    <field name="res_model">ibco.delivery.line</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
