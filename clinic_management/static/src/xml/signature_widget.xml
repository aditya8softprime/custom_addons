<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="clinic_management.DrawCanvasWidget">
        <div class="o_draw_canvas_widget">
            <!-- Toolbar for page navigation and actions -->
            <div class="o_draw_canvas_toolbar">
                <button type="button"
                        t-att-class="'btn btn-sm ' + (state.tool === 'pen' ? 'btn-primary' : 'btn-outline-secondary')"
                        t-on-click="onToolPen">Pen</button>
                <button type="button"
                        t-att-class="'btn btn-sm ml-1 ' + (state.tool === 'eraser' ? 'btn-primary' : 'btn-outline-secondary')"
                        t-on-click="onToolEraser">Eraser</button>
                <label class="ml-2 mr-1">Size</label>
                <input type="range" min="2" max="80" step="1" t-on-change="onBrushSizeChange" style="width:140px"/>
                <span class="ml-1" t-esc="state.brushSize"/> px
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="onPrevPage">Prev</button>
                <span class="mx-2">Page <t t-esc="state.currentPage"/> / <t t-esc="state.totalPages"/></span>
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="onNextPage">Next</button>
                <button type="button" class="btn btn-primary btn-sm ml-3" t-on-click="onAddPage">Add Page</button>
                <button type="button" class="btn btn-danger btn-sm ml-1" t-on-click="onRemovePage">Remove Page</button>
            </div>
            
            <!-- Doctor's Prescription Template as Background -->
            <div t-if="props.record.data.doctor_id" 
                 class="prescription-template-bg"
                 t-att-style="'position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: url(/web/image/clinic.doctor/' + (Array.isArray(props.record.data.doctor_id) ? props.record.data.doctor_id[0] : props.record.data.doctor_id) + '/prescription_template_image); background-size: cover; background-position: center; background-repeat: no-repeat; z-index: 1;'"></div>
            
            <!-- Canvas for Drawing on Top of Template -->
            <canvas t-ref="canvas" 
                    width="2480" 
                    height="3508" 
                    style="position: relative; width:100%; height:100%; display:block; z-index: 2; background: transparent; cursor: crosshair; touch-action: none;"></canvas>
        </div>
    </t>
</templates>