<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="clinic_management.AppointmentDashboard">
        <div class="o_appointment_dashboard container-fluid p-4">
            <t t-set="_style_block">
                <style>
                    .o_appointment_dashboard .filter-toolbar .btn,
                    .o_appointment_dashboard .filter-toolbar .input-group .form-control,
                    .o_appointment_dashboard .filter-toolbar .input-group .input-group-text {
                        height: 38px;
                    }
                    .o_appointment_dashboard .filter-toolbar .btn-group + .btn-group,
                    .o_appointment_dashboard .filter-toolbar .btn-group + .date-group,
                    .o_appointment_dashboard .filter-toolbar .date-group + .btn-group {
                        margin-left: .5rem;
                    }
                    .o_appointment_dashboard .filter-toolbar .date-group {
                        max-width: 260px;
                    }
                    @media (max-width: 768px) {
                        .o_appointment_dashboard .filter-toolbar {
                            flex-wrap: wrap;
                        }
                        .o_appointment_dashboard .filter-toolbar > * {
                            margin-top: .5rem;
                        }
                    }
                </style>
            </t>
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Appointment Dashboard</h2>
                <div class="filter-toolbar btn-toolbar gap-2 align-items-center" role="toolbar">
                    <!-- Doctor Filter -->
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                            <t t-if="state.doctor_id">
                                <t t-foreach="state.doctors" t-as="doctor" t-key="doctor.id">
                                    <t t-if="state.doctor_id === doctor.id">
                                        <t t-esc="doctor.name"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">Select Doctor</t>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" t-on-click="(event) => this.on_doctor_change({ target: { value: '' } })">All Doctors</a></li>
                            <t t-foreach="state.doctors" t-as="doctor" t-key="doctor.id">
                                <li><a class="dropdown-item" href="#" t-on-click="(event) => this.on_doctor_change({ target: { value: doctor.id } })"><t t-esc="doctor.name"/></a></li>
                            </t>
                        </ul>
                    </div>
                    
                    <!-- Appointment Type Filter -->
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                            <t t-if="state.appointment_type === 'scheduled'">Scheduled</t>
                            <t t-elif="state.appointment_type === 'walkin'">Walk-in</t>
                            <t t-else="">All Types</t>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" t-on-click="(event) => this.on_appointment_type_change({ target: { value: '' } })">All Types</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click="(event) => this.on_appointment_type_change({ target: { value: 'scheduled' } })">Scheduled</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click="(event) => this.on_appointment_type_change({ target: { value: 'walkin' } })">Walk-in</a></li>
                        </ul>
                    </div>
                    
                    <!-- Time Filter Buttons -->
                    <div class="btn-group" role="group">
                        <button type="button" t-att-class="state.time_filter === 'today' ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('today')">Today</button>
                        <button type="button" t-att-class="state.time_filter === 'tomorrow' ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('tomorrow')">Tomorrow</button>
                        <button type="button" t-att-class="state.time_filter === 'week' ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('week')">Week</button>
                        <button type="button" t-att-class="state.time_filter === 'month' ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('month')">Month</button>
                        <button type="button" t-att-class="state.time_filter === 'year' ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('year')">Year</button>
                        <button type="button" t-att-class="state.time_filter === 'till_now' || state.time_filter === null ? 'btn btn-primary' : 'btn btn-outline-primary'" t-on-click="(event) => this.on_time_filter_change('till_now')">All Time</button>
                    </div>
                    
                    <!-- Date Picker -->
                    <div class="input-group date-group">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                        <input type="date" class="form-control" t-att-value="state.selected_date" t-on-change="(event) => this.on_date_change(event)" placeholder="Select Date"/>
                        <button class="btn btn-outline-secondary" type="button" t-on-click="(event) => this.clear_date_filter()" title="Clear Date Filter">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link" t-att-class="state.active_tab === 'overview' ? 'active' : ''" href="#" t-on-click="(event) => this.set_active_tab('overview')">Overview</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" t-att-class="state.active_tab === 'doctors' ? 'active' : ''" href="#" t-on-click="(event) => this.set_active_tab('doctors')">Doctors &amp; Slots</a>
                </li>
            </ul>

            <!-- Dashboard Cards -->
            <div t-if="state.active_tab === 'overview'" class="row g-4 mb-4">
                <!-- Total Appointments -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;" t-on-click="(event) => this._open_list_view(null)">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-calendar fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_appointments"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Total Appointments</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Confirmed -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #007bff; color: white;" t-on-click="(event) => this._open_list_view('confirmed')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-check-circle fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_confirmed"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Confirmed</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Paid -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #20c997; color: white;" t-on-click="(event) => this._open_list_view('paid')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-credit-card fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_paid"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Paid</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Waiting -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #fd7e14; color: white;" t-on-click="(event) => this._open_list_view('waiting')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-hourglass-half fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_waiting"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Waiting</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Completed -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #28a745; color: white;" t-on-click="(event) => this._open_list_view('completed')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-check fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_completed"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Completed</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Patient In -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #17a2b8; color: white;" t-on-click="(event) => this._open_list_view('patient_in')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-user-check fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_patient_in"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Patient In</h5>
                        </div>
                    </div>
                </div>
                
                <!-- In Consultation -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #ffc107; color: white;" t-on-click="(event) => this._open_list_view('in_consultation')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-stethoscope fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_in_consultation"/></h2>
                            </div>
                            <h5 class="card-title mb-2">In Consultation</h5>
                        </div>
                    </div>
                </div>
                
                <!-- No Show -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #e83e8c; color: white;" t-on-click="(event) => this._open_list_view('no_show')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-user-times fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_no_show"/></h2>
                            </div>
                            <h5 class="card-title mb-2">No Show</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Cancelled -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm clickable-card" style="background-color: #dc3545; color: white;" t-on-click="(event) => this._open_list_view('cancelled')">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-times-circle fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_cancelled"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Cancelled</h5>
                        </div>
                    </div>
                </div>
                
                <!-- Total Revenue -->
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <i class="fa fa-dollar fa-2x me-3"></i>
                                <h2 class="mb-0 fw-bold"><t t-esc="state.total_revenue.toFixed(2)"/></h2>
                            </div>
                            <h5 class="card-title mb-2">Total Revenue</h5>
                        </div>
                    </div>
                </div>

                <!-- Appointments List in Overview -->
                <div class="mt-5 table-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3><t t-if="state.selected_state"><t t-esc="state.selected_state.toUpperCase().replace('_', ' ')"/> Appointments</t><t t-else="">Recent Appointments</t></h3>
                    </div>

                    <div class="table-container">
                        <table t-if="state.records.length > 0" class="table table-striped table-bordered">
                            <thead class="table-header sticky-top">
                                <tr>
                                    <th>Reference</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Appointment Type</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.records" t-as="record" t-key="record.id">
                                    <tr t-on-click="(event) => this.open_appointment_form(record)" style="cursor: pointer;">
                                        <td><t t-esc="record.name"/></td>
                                        <td><t t-esc="record.patient_name || '-'"/></td>
                                        <td><t t-esc="record.doctor_name || '-'"/></td>
                                        <td>
                                            <span t-att-class="'badge bg-' + (record.appointment_type === 'scheduled' ? 'primary' : 'info')">
                                                <t t-esc="record.appointment_type ? record.appointment_type.toUpperCase().replace('_', ' ') : 'SCHEDULED'"/>
                                            </span>
                                        </td>
                                        <td><t t-esc="record.appointment_date || '-'"/></td>
                                        <td><t t-esc="record.time_slot || '-'"/></td>
                                        <td>
                                            <span t-att-class="'badge bg-' + (record.state === 'completed' ? 'success' : record.state === 'confirmed' ? 'primary' : record.state === 'paid' ? 'success' : record.state === 'waiting' ? 'warning' : record.state === 'patient_in' ? 'info' : record.state === 'in_consultation' ? 'warning' : record.state === 'cancelled' ? 'danger' : record.state === 'no_show' ? 'dark' : 'light text-dark')">
                                                <t t-esc="record.state.toUpperCase().replace('_', ' ')"/>
                                            </span>
                                        </td>
                                        <td><t t-esc="record.consulting_fee.toFixed(2)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-if="state.records.length === 0">
                            <p class="text-muted p-3">No appointment records found.</p>
                        </t>
                    </div>

                    <!-- Pagination -->
                    <t t-if="state.records.length > 0">
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <p class="mb-0">Showing <t t-esc="(state.current_page - 1) * state.records_per_page + 1"/> to <t t-esc="Math.min(state.current_page * state.records_per_page, state.total_records)"/> of <t t-esc="state.total_records"/> records</p>
                            </div>
                            <div>
                                <button class="btn btn-outline-primary me-2" t-att-disabled="state.current_page === 1" t-on-click="go_to_previous_page">Previous</button>
                                <button class="btn btn-outline-primary" t-att-disabled="state.current_page >= Math.ceil(state.total_records / state.records_per_page)" t-on-click="go_to_next_page">Next</button>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Charts Section -->
                <div class="mt-5 chart-card">
                    <h3 class="mb-3">Appointment Status Distribution</h3>
                    <div class="chart-flex">
                        <div class="chart-frame mb-3 mb-md-0 me-md-3" style="flex:1;">
                            <canvas id="appointmentPieChart"></canvas>
                        </div>
                        <div class="chart-frame" style="flex:1;">
                            <canvas id="appointmentBarChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doctors & Slots Section -->
            <div t-if="state.active_tab === 'doctors'" class="mt-4">
                <div class="row">
                    <t t-foreach="state.doctors_data" t-as="doctor_data" t-key="doctor_data.id">
                        <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="card-title mb-0">
                                        <i class="fa fa-user-md me-2"></i>
                                        <t t-esc="doctor_data.name"/>
                                    </h5>
                                    <small>
                                        <i class="fa fa-stethoscope me-1"></i>
                                        <t t-esc="doctor_data.service_category"/>
                                    </small>
                                </div>
                                <div class="card-body p-3">
                                    <!-- If no date filter is selected, show only doctor card without slots -->
                                    <t t-if="!state.time_filter">
                                        <div class="text-muted small">Select Today/Tomorrow/Date to view slots.</div>
                                    </t>
                                    <t t-elif="doctor_data.slots.length > 0">
                                        <div class="row g-2">
                                            <t t-foreach="doctor_data.slots" t-as="slot" t-key="slot.id">
                                                <div class="col-6 col-sm-4">
                                                    <div t-att-class="slot.is_booked ? 'slot-box booked-slot' : 'slot-box available-slot'" 
                                                         t-att-title="slot.is_booked ? 'Already Booked - Click to see message' : 'Available - Click to book'"
                                                         t-on-click="slot.is_booked ? (event) => this.show_booked_slot_message() : (event) => this.book_slot(doctor_data.id, slot.id, doctor_data.name, doctor_data.service_id)">
                                                        <div class="slot-time">
                                                            <t t-esc="slot.slot_label"/>
                                                        </div>
                                                        <div class="slot-status">
                                                            <t t-if="slot.is_booked">
                                                                <i class="fa fa-times-circle"></i> Booked
                                                            </t>
                                                            <t t-else="">
                                                                <i class="fa fa-check-circle"></i> Available
                                                            </t>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center text-muted p-3">
                                            <i class="fa fa-calendar-times fa-2x mb-2"></i>
                                            <p class="mb-0">No slots available for selected date</p>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <!-- Empty state when no doctors -->
                <t t-if="state.doctors_data.length === 0">
                    <div class="text-center text-muted p-5">
                        <i class="fa fa-user-md fa-3x mb-3"></i>
                        <h4>No doctors found</h4>
                        <p>No doctors available for the selected date and filters.</p>
                    </div>
                </t>
            </div>
        </div>
        
        <style>
            .slot-box {
                padding: 8px;
                border-radius: 8px;
                text-align: center;
                font-size: 12px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s ease;
                border: 2px solid transparent;
                min-height: 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            
            .available-slot {
                background: #28a745;
                color: white;
                border-color: #28a745;
            }
            
            .available-slot:hover {
                background: #218838;
                border-color: #1e7e34;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3);
            }
            
            .booked-slot {
                background: #dc3545;
                color: white;
                border-color: #dc3545;
                cursor: not-allowed;
                opacity: 0.8;
            }
            
            .slot-time {
                font-weight: bold;
                margin-bottom: 2px;
            }
            
            .slot-status {
                font-size: 10px;
                opacity: 0.9;
            }
            
            .slot-status i {
                margin-right: 3px;
            }
        </style>
    </t>
</templates>
