<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Doctor Shift Config Views -->
    <record id="view_doctor_shift_config_form" model="ir.ui.view">
        <field name="name">doctor.shift.config.form</field>
        <field name="model">doctor.shift.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="doctor_id"/>
                            <field name="day_id"/>
                            <field name="shift_type"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="slot_duration"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doctor_shift_config_list" model="ir.ui.view">
        <field name="name">doctor.shift.config.list</field>
        <field name="model">doctor.shift.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_id"/>
                <field name="day_id"/>
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="slot_duration"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_doctor_shift_config" model="ir.actions.act_window">
        <field name="name">Doctor Shift Configurations</field>
        <field name="res_model">doctor.shift.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create doctor shift configurations
            </p>
            <p>
                Configure doctor schedules by day and shift type to automatically generate appointment slots.
            </p>
        </field>
    </record>
</odoo>