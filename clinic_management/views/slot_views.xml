<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_slot_form" model="ir.ui.view">
        <field name="name">clinic.slot.form</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <form>
        <header>
            <button name="action_toggle_block" type="object" string="Toggle Block" class="btn-secondary"/>
            <button name="action_cancel_appointments" type="object" string="Cancel All Appointments" class="btn-danger"/>
        </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="slot_number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="New Structure">
                            <field name="doctor_id"/>
                            <field name="shift_config_id"/>
                            <field name="day_of_week"/>
                            <field name="shift_type"/>
                            <field name="slot_label"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                        <group string="Flags and Stats">
                            <field name="is_blocked"/>
                            <field name="patients_count"/>
                            <field name="color" invisible="1"/>
                        </group>
                    </group>
                    <group string="Legacy Fields (Backward Compatibility)" invisible="not day_id">
                        <group>
                            <field name="day_id"/>
                            <field name="shift"/>
                            <field name="slot_number"/>
                            <field name="start_time_float" widget="float_time"/>
                            <field name="end_time_float" widget="float_time"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="appointment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clinic_slot_list" model="ir.ui.view">
        <field name="name">clinic.slot.list</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <list string="Slots">
                <field name="doctor_id"/>
                <field name="day_of_week"/>
                <field name="shift_type"/>
                <field name="slot_label"/>
                <field name="start_time"/>
                <field name="end_time"/>
          <field name="patients_count"/>
          <field name="is_blocked"/>
                <!-- Legacy fields for backward compatibility -->
                <field name="day_id" optional="hide"/>
                <field name="shift" optional="hide"/>
                <field name="slot_number" optional="hide"/>
                <field name="start_time_float" widget="float_time" optional="hide"/>
                <field name="end_time_float" widget="float_time" optional="hide"/>
                <field name="duration" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_slot_kanban" model="ir.ui.view">
        <field name="name">clinic.slot.kanban</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="doctor_id" records_draggable="0" class="o_kanban_small_column">
                <field name="doctor_id"/>
                <field name="day_id"/>
                <field name="slot_number"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="is_blocked"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill #{color ? 'oe_kanban_color_' + color : ''}">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="slot_number"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="day_id"/>
                                </div>
                                <div>
                                    <strong>Time: </strong>
                                    <t t-if="record.slot_label.raw_value">
                                        <t t-esc="record.slot_label.value"/>
                                    </t>
                                    <t t-else="">
                                        <field name="start_time_float" widget="float_time"/> - <field name="end_time_float" widget="float_time"/>
                                    </t>
                                </div>
                                <div>
                                    <div>
                                        <span t-if="record.is_blocked.raw_value" class="badge text-bg-warning">Blocked</span>
                                        <span t-else="" class="badge text-bg-success">Open</span>
                                    </div>
                                </div>
                                <div>
                                    <strong>Appointments: </strong>
                                    <field name="patients_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_clinic_slot_calendar" model="ir.ui.view">
        <field name="name">clinic.slot.calendar</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <calendar string="Slots" date_start="start_time_float" date_stop="end_time_float" mode="day" color="doctor_id">
                <field name="slot_number"/>
                <field name="doctor_id"/>
                <field name="is_blocked"/>
            </calendar>
        </field>
    </record>

    <record id="view_clinic_slot_search" model="ir.ui.view">
        <field name="name">clinic.slot.search</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="slot_number"/>
                <field name="doctor_id"/>
                <field name="day_id"/>
                <separator/>
                <filter string="Open" name="open" domain="[('is_blocked', '=', False)]"/>
                <filter string="Blocked" name="blocked" domain="[('is_blocked', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'day_id'}"/>
                    <filter name="group_by_blocked" string="Blocked" context="{'group_by': 'is_blocked'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_slot" model="ir.actions.act_window">
        <field name="name">Slots</field>
        <field name="res_model">clinic.slot</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="context">{'search_default_group_by_doctor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No slots defined!
            </p>
            <p>
                Slots are automatically generated when you create or update a doctor's availability.
            </p>
        </field>
    </record>
</odoo>
